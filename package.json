{
  "name": "personel-management-app",
  "private": true,
  "workspaces": [
    "packages/desktop",
    "packages/server",
    "packages/shared"
  ],
  "scripts": {
    "dev:server": "npm run dev -w @personel-management-app/server",
    "dev:desktop": "npm run dev -w @personel-management-app/desktop",
    "build:server": "npm run build -w @personel-management-app/server",
    "build:desktop": "npm run build -w @personel-management-app/desktop",
    "build:shared": "npm run build -w @personel-management-app/shared",
    "db:migrate": "npm run db:migrate -w @personel-management-app/server",
    "db:generate": "npm run db:generate -w @personel-management-app/server",
    "pm2:start": "npm run build -w @personel-management-app/server && pm2 start packages/server/ecosystem.config.cjs",
    "pm2:restart": "npm run build -w @personel-management-app/server && pm2 restart personel-management-server",
    "pm2:stop": "pm2 stop personel-management-server",
    "postinstall": "npm run build:shared"
  },
  "dependencies": {
    "rc9": "^3.1.0"
  }
}
